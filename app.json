{
  "expo": {
    "name": "Gorée Island",
    "slug": "goree-island",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goreeisland",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.daw.goreeisland",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.daw.goreeisland",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4E2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Gorée Island utilise le micro pour que tu puisses parler à l'assistant vocal Téranga."
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Gorée Island utilise la caméra pour photographier ta CNI et prendre un selfie (tarif national de l'entrée du site).",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gorée Island utilise ta position pour déclencher l'audio-guide devant chaque lieu de l'île."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#C4401F"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gorée Island utilise Face ID pour confirmer tes paiements et protéger ton compte."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
